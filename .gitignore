# Build output (arduino-cli builds to a temp dir by default, but --output-dir
# or an IDE can drop artifacts here)
build/
*.elf
*.hex
*.map
*.zip
*.uf2
*.bin

# Host test binaries
tests/test_all
tests/*.dSYM/

# macOS
.DS_Store

# Android
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
*.apk
*.aab

# iOS -- Secrets.plist holds the Nightscout token and must never be committed
ios/GlucoseRing/Secrets.plist
ios/**/xcuserdata/
ios/**/*.xcuserstate
ios/build/
DerivedData/
